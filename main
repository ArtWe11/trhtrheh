          <button type="button" onclick="closeHabitModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm font-semibold">
            Скасувати
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-md shadow-indigo-500/20">
            Зберегти звичку
          </button>
        </div>
      </form>
    </div>
  </div>

